generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id            String   @id @default(cuid())
  deceasedName  String
  deceasedAge   Int?
  description   String
  eventDate     DateTime
  eventTime     String?
  venue         String?
  capacity      Int      @default(200)
  createdAt     DateTime @default(now())

  guests        Guest[]
}

model Guest {
  id            String   @id @default(cuid())
  fullName      String
  phoneNumber   String   // for WhatsApp sending, include country code e.g. +2348012345678
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  createdAt     DateTime @default(now())

  invite        Invite?
}

model Invite {
  id            String       @id @default(cuid())
  token         String       @unique @default(cuid()) // this is what gets encoded in the QR code
  guestId       String       @unique
  guest         Guest        @relation(fields: [guestId], references: [id])
  status        InviteStatus @default(NOT_CHECKED_IN)
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  createdAt     DateTime     @default(now())

  logs          CheckLog[]
}

model CheckLog {
  id            String      @id @default(cuid())
  inviteId      String
  invite        Invite      @relation(fields: [inviteId], references: [id])
  action        CheckAction
  scannedAt     DateTime    @default(now())
}

enum InviteStatus {
  NOT_CHECKED_IN
  CHECKED_IN
  CHECKED_OUT
}

enum CheckAction {
  CHECK_IN
  CHECK_OUT
}